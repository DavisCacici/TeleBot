  "stepIdx": 28,
  "toolCall": {
    "args": {
      "CodeContent": "const { Pool } = require('pg');\n\nconst connectionString =\n  process.env.DATABASE_URL ||\n  `postgresql://${process.env.POSTGRES_USER || 'postgres'}:${process.env.POSTGRES_PASSWORD || 'postgres'}@${process.env.POSTGRES_HOST || 'localhost'}:${process.env.POSTGRES_PORT || 5432}/${process.env.POSTGRES_DB || 'telegraf_logs'}`;\n\nconst pool = new Pool({\n  connectionString\n});\n\npool.on('error', (err) => {\n  console.error('Errore imprevisto sul client PostgreSQL:', err.message);\n});\n\nasync function initDb() {\n  try {\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS logs (\n        id SERIAL PRIMARY KEY,\n        created_at TIMESTAMPTZ DEFAULT NOW(),\n        level VARCHAR(20) NOT NULL DEFAULT 'INFO',\n        event_type VARCHAR(100) NOT NULL,\n        chat_id BIGINT,\n        project_name VARCHAR(255),\n        conversation_id VARCHAR(255),\n        message TEXT,\n        payload JSONB\n      );\n    `);\n\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS bot_state (\n        key VARCHAR(100) PRIMARY KEY,\n        value JSONB NOT NULL,\n        updated_at TIMESTAMPTZ DEFAULT NOW()\n      );\n    `);\n\n    console.log('🗄️ Database PostgreSQL inizializzato correttamente.');\n  } catch (err) {\n    console.error('❌ Errore durante l\\'inizializzazione del database PostgreSQL:', err.message);\n  }\n}\n\nasync function saveLog({\n  level = 'INFO',\n  eventType = 'general',\n  chatId = null,\n  projectName = null,\n  conversationId = null,\n  message = '',\n  payload = null\n}) {\n  try {\n    await pool.query(\n      `INSERT INTO logs (level, event_type, chat_id, project_name, conversation_id, message, payload)\n       VALUES ($1, $2, $3, $4, $5, $6, $7)`,\n      [\n        level,\n        eventType,\n        chatId ? Number(chatId) : null,\n        projectName,\n        conversationId,\n        message,\n        payload ? JSON.stringify(payload) : null\n      ]\n    );\n  } catch (err) {\n    console.error('Errore durante il salvataggio del log su PostgreSQL:', err.message);\n  }\n}\n\nasync function loadStateFromDb() {\n  try {\n    const res = await pool.query(`SELECT value FROM bot_state WHERE key = 'main_state'`);\n    if (res.rows.length > 0) {\n      return res.rows[0].value;\n    }\n    return null;\n  } catch (err) {\n    console.error('Errore durante il caricamento dello stato da PostgreSQL:', err.message);\n    return null;\n  }\n}\n\nasync function saveStateToDb(stateObj) {\n  try {\n    await pool.query(\n      `INSERT INTO bot_state (key, value, updated_at)\n       VALUES ('main_state', $1, NOW())\n       ON CONFLICT (key) DO UPDATE\n       SET value = EXCLUDED.value, updated_at = NOW()`,\n      [JSON.stringify(stateObj)]\n    );\n  } catch (err) {\n    console.error('Errore durante il salvataggio dello stato su PostgreSQL:', err.message);\n  }\n}\n\nmodule.exports = {\n  pool,\n  initDb,\n  saveLog,\n  loadStateFromDb,\n  saveStateToDb\n};\n",
      "Description": "Creazione del modulo db.js per gestire la connessione a PostgreSQL e il salvataggio di log e stato del bot",
