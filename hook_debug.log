{
  "artifactDirectoryPath": "C:/Users/davis.cacici/.gemini/antigravity-cli/brain/a665df2a-dc65-44c9-8d33-e4aced99a890",
  "conversationId": "a665df2a-dc65-44c9-8d33-e4aced99a890",
